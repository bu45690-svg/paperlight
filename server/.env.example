# Copy this file to .env and fill in your real key. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional: folder for the fastembed ONNX model cache (default: system temp dir).
# Avoid OneDrive-synced folders. Example: C:\Users\DELL\.cache\fastembed
# FASTEMBED_CACHE_DIR=
